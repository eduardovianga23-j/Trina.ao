# Copia este ficheiro para ".env" e preenche os valores.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/trina_ao

# Chave secreta para as sessões (login). Gera uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

CLIENT_URL=http://localhost:5173

# Opcional: quando o site estiver online, guarda as fotos no Cloudinary.
# Copia o "API environment variable" do painel do Cloudinary, ex.:
# CLOUDINARY_URL=cloudinary://123456789:abcdef@o-teu-cloud-name
CLOUDINARY_URL=

# Opcional: botão "Continuar com o Google" no login e no registo.
# Cria um "ID do cliente OAuth" (tipo: Aplicação Web) em https://console.cloud.google.com/apis/credentials
# e cola aqui o ID (termina em .apps.googleusercontent.com).
GOOGLE_CLIENT_ID=

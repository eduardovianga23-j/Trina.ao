# Copia este ficheiro para ".env" e preenche os valores.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/trina_ao

# Chave secreta para as sessões (login). Gera uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

CLIENT_URL=http://localhost:5173

# Opcional: quando o site estiver online, guarda as fotos no Cloudinary.
# Copia o "API environment variable" do painel do Cloudinary, ex.:
# CLOUDINARY_URL=cloudinary://123456789:abcdef@o-teu-cloud-name
CLOUDINARY_URL=

# Opcional: botão "Continuar com o Google" no login e no registo.
# Cria um "ID do cliente OAuth" (tipo: Aplicação Web) em https://console.cloud.google.com/apis/credentials
# e cola aqui o ID (termina em .apps.googleusercontent.com).
GOOGLE_CLIENT_ID=

# Pagamentos (Stripe): MB WAY, Multibanco, cartão, Apple Pay, Google Pay.
# Em https://dashboard.stripe.com/test/apikeys copia a "Secret key" (começa por sk_test_ nos testes).
STRIPE_SECRET_KEY=
# Só quando o site estiver online: segredo do webhook (começa por whsec_).
# Endpoint: https://O-TEU-SITE/api/payments/webhook
STRIPE_WEBHOOK_SECRET=

# Portes de envio em euros (opcional). FREE_SHIPPING_FROM=0 → nunca é grátis.
SHIPPING_COST=3.99
FREE_SHIPPING_FROM=50
# Portes para os Açores e a Madeira (códigos postais começados por 9)
SHIPPING_COST_ISLANDS=6.99
FREE_SHIPPING_FROM_ISLANDS=80

# Emails automáticos (opcional). Com o Gmail:
#   1. Liga a "Verificação em 2 passos" em https://myaccount.google.com/security
#   2. Cria uma "Palavra-passe de app" em https://myaccount.google.com/apppasswords
#   3. Cola aqui o teu Gmail e essa palavra-passe (16 letras). NÃO é a senha normal do Gmail.
# Sem isto, os emails não são enviados mas ficam guardados em server/emails/ para veres como ficam.
SMTP_USER=
SMTP_PASS=
# Email que recebe os avisos de encomendas novas (por defeito, o SMTP_USER)
STORE_EMAIL=

# Faturas certificadas automáticas (opcional) com o InvoiceXpress — https://invoicexpress.com
# Em cada encomenda paga é emitida uma fatura-recibo e enviada por email ao cliente.
#   INVOICEXPRESS_ACCOUNT = o nome antes de .app.invoicexpress.com (ex.: "trina" em trina.app.invoicexpress.com)
#   INVOICEXPRESS_API_KEY = no InvoiceXpress: Definições → API
INVOICEXPRESS_ACCOUNT=
INVOICEXPRESS_API_KEY=
# Taxa de IVA dos produtos (os preços da loja já incluem IVA). Confirma com o teu contabilista.
INVOICE_VAT_RATE=23
# As faturas não se podem apagar: com o Stripe em modo de teste (sk_test_) não são emitidas automaticamente.
# Para testar com uma conta de testes do InvoiceXpress, põe INVOICE_WITH_TEST_PAYMENTS=1
INVOICE_WITH_TEST_PAYMENTS=
